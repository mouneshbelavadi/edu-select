# ==============================================================================
# EduSelect - Environment Variables Template
#
# IMPORTANT SECURITY & PRIVACY NOTICE:
# - NEVER commit your real secrets (.env or .env.local) to Git.
# - DO NOT use NEXT_PUBLIC_ prefixes for private API keys or database URLs.
# - All keys listed here are server-side only and never exposed to the frontend/browser.
# ==============================================================================

# 1. Neon Serverless PostgreSQL Database Connections
# DATABASE_URL: Pooled connection string (PgBouncer) for runtime queries
DATABASE_URL="postgresql://<user>:<password>@<neon-pooled-host>/neondb?sslmode=require"
# DIRECT_URL: Direct unpooled connection string for migrations and schema pushes
DIRECT_URL="postgresql://<user>:<password>@<neon-direct-host>/neondb?sslmode=require"

# 2. NextAuth.js Authentication Configuration
# NEXTAUTH_URL: Canonical deployment URL (http://localhost:3000 locally, or https://<site>.netlify.app in production)
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET: Generate via `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-secure-random-32-char-string"

# 3. Google Gemini AI Career Counsellor (Server-Side Only - Zero Client Leakage)
# GEMINI_API_KEY: Your private Google AI Studio API key (kept strictly on server)
GEMINI_API_KEY=""
# GEMINI_MODEL: Economical / Free-Tier model choices:
#   - "gemini-1.5-flash-8b" : [RECOMMENDED] Google's most economical, lowest-cost model
#                             ($0.0375 / 1M input tokens; FREE up to 15 RPM / 1,500 RPD)
#   - "gemini-1.5-flash"    : High speed, low cost ($0.075 / 1M tokens; also free tier eligible)
#   - "gemini-2.0-flash-lite": Ultra low-latency, low cost
GEMINI_MODEL="gemini-1.5-flash-8b"
# GEMINI_TIMEOUT_MS: Serverless safety guard in milliseconds (default 20 seconds)
GEMINI_TIMEOUT_MS="20000"

# 4. Database Seed Passwords (used only when running `npm run db:seed`)
SEED_ADMIN_PASSWORD="MySecureAdminPassword123"
SEED_DEMO_PASSWORD="MyDemoStudentPassword123"
